# Gaia (NKI) site configuration — copy to paths.env. Raw cohorts live on
# /mnt/kronos/data_public; the non-HF cohorts go through the adapters built by
# scripts/build_gaia_adapters.py (manifests + symlinks), see ../GAIA_PATHS.md.
FM_PROJECT=/home/g.yiasemis/projects/cvpr_ct_challenge/aifofomo
FM_SAVE_ROOT=/projects/direct/temp/fm_probe/v2
FM_CONDA_SH=/home/g.yiasemis/miniconda3/etc/profile.d/conda.sh
FM_CONDA_ENV=aifofomo-fm-probe
FM_SLURM_ACCOUNT=aifo
FM_SLURM_PARTITIONS=a6000:a6000_qos
FM_SLURM_CPUS=16
FM_SLURM_MEM=120G

FM_DATA_AMOS=/projects/cvpr2026_challenge_fomo4ct/CVPR26-3DCTFMCompetition/AMOS-clf-tr-val
FM_DATA_COVID=/projects/cvpr2026_challenge_fomo4ct/CVPR26-3DCTFMCompetition/COVID-CT
FM_DATA_LUNA=/projects/cvpr2026_challenge_fomo4ct/CVPR26-3DCTFMCompetition/LUNA25
FM_DATA_FDG=/mnt/kronos/data_public/FDG-PET-CT-Lesions
FM_DATA_RSNA2022=/mnt/kronos/data_public/RSNA-2022-Cervical-Spine-Fracture-Detection   # labels.csv + images/ (relative links into niftis/)
FM_DATA_RSNA2023=/mnt/kronos/data_public/RSNA-2023-Abdominal-Trauma-Detection
FM_DATA_RSNA2019_ICH=/mnt/kronos/data_public/RSNA-2019-Intracranial-Hemorrhage-Detection/niftis   # converted NIfTIs + patient tables (moved from /projects/direct)
FM_DATA_BREASTDIVIDER=/mnt/kronos/data_public/BreastDivider

FM_VOCO_WEIGHTS=/projects/cvpr2026_challenge_fomo4ct/pretrained/VoCo_L_SSL_head.pt
FM_PILLAR0_HEAD_WEIGHTS=/projects/cvpr2026_challenge_fomo4ct/pretrained/Pillar0-HeadCT
FM_PILLAR0_BREAST_WEIGHTS=/projects/cvpr2026_challenge_fomo4ct/pretrained/Pillar0-BreastMRI

# --- segmentation suite (examples/fm_probes/fm_seg) -------------------------------
